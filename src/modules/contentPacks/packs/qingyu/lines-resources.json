{
  "memories": {
    "mem.ningyu.o2.agree": {
      "summary": "南行途中，程宗扬应下了她弑主的开价，没有问她为什么。",
      "salienceId": "sal.notable"
    },
    "mem.ningyu.o2.refuse": {
      "summary": "南行途中，程宗扬回绝了她的开价，说不替人弑主。",
      "salienceId": "sal.notable"
    },
    "mem.ningyu.o2.ask_why": {
      "summary": "南行途中，程宗扬没有答应也没有回绝，只问她为什么。",
      "salienceId": "sal.notable"
    },
    "mem.ningyu.y3.public": {
      "summary": "黑石滩过河后，程宗扬当着众人向她道谢，她没有接话。",
      "salienceId": "sal.notable"
    },
    "mem.ningyu.y3.private": {
      "summary": "黑石滩过河后，程宗扬私下把干衣服递到她手边，她接了。",
      "salienceId": "sal.notable"
    },
    "mem.ningyu.y3.nothing": {
      "summary": "黑石滩过河后，程宗扬什么也没有做。",
      "salienceId": "sal.notable"
    },
    "mem.ningyu.y5.bring": {
      "summary": "进峒前，程宗扬让人扶着她一同进去。",
      "salienceId": "sal.notable"
    },
    "mem.ningyu.y5.stay": {
      "summary": "进峒前，程宗扬把她留在了峒外。",
      "salienceId": "sal.notable"
    },
    "mem.ningyu.y5.ask": {
      "summary": "进峒前，程宗扬先问了她自己的意思。",
      "salienceId": "sal.notable"
    },
    "mem.ningyu.y6.word": {
      "summary": "临别那天，程宗扬隔着门对她说了一句话，门没有开。",
      "salienceId": "sal.notable"
    },
    "mem.ningyu.y6.token": {
      "summary": "临别那天，程宗扬在她的门前留下了一样东西，门没有开。",
      "salienceId": "sal.notable"
    },
    "mem.lmz.l1.rush": {
      "summary": "鸦人营地里，她冲出去时，程宗扬立刻跟着冲了出来。",
      "salienceId": "sal.notable"
    },
    "mem.lmz.l1.wait": {
      "summary": "鸦人营地里，她冲出去时，程宗扬先按住性子等鸦人露出破绽。",
      "salienceId": "sal.notable"
    },
    "mem.lmz.l1.shield": {
      "summary": "鸦人营地里，程宗扬先抢到她身前护住了她。",
      "salienceId": "sal.notable"
    },
    "mem.lmz.l2.share": {
      "summary": "分烤鹅掌菌时，程宗扬掰了一半给她。",
      "salienceId": "sal.notable"
    },
    "mem.lmz.l4.laugh": {
      "summary": "鬼王宫里重逢，她给了程宗扬一巴掌，他笑着认栽。",
      "salienceId": "sal.notable"
    },
    "mem.lmz.l4.scold": {
      "summary": "鬼王宫里重逢，她给了程宗扬一巴掌，他数落了她两句。",
      "salienceId": "sal.notable"
    },
    "mem.lmz.l4.run": {
      "summary": "鬼王宫里重逢，她给了程宗扬一巴掌，他二话不说拉着她就跑。",
      "salienceId": "sal.notable"
    },
    "mem.lmz.l3.pull": {
      "summary": "海神殿里，程宗扬替她把卡住的鱼叉拔了下来。",
      "salienceId": "sal.notable"
    },
    "mem.lmz.l3.bandage": {
      "summary": "海神殿里，程宗扬替她拔下鱼叉，又把她的伤处仔细包好。",
      "salienceId": "sal.notable"
    }
  },
  "facts": {
    "fact.lmz.phoenix_change": {
      "subjectId": "liuchao.character.le_mingzhu",
      "claim": "乐明珠在奴隶暴动中浑身发热，红光涌动，谢艺说与当年的情形如出一辙，不必担心。"
    }
  },
