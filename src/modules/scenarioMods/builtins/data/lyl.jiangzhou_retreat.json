          "spiritRoot": {
            "name": "变异灵根",
            "tier": "天品",
            "description": "灵根异变破常理，潜力无穷，修炼者似逆命而行，主颠覆与意外之变。"
          },
          "talents": [
            {
              "name": "天命主角",
              "description": "灾难收束为踏脚石，机缘如雨点砸来，他站在风暴眼笑看命运齿轮碾碎所有敌人。"
            },
            {
              "name": "纸币发行权",
              "description": "程宗扬的专属异能。"
            }
          ],
          "appearance": "身材魁梧，身穿黑衣，赤阳藤拖入魔墟时衣衫破损，被雪雪咬伤后曾不举，颈后有狐族印记，被襄城君认出，青年男子",
          "personality": [
            "随和洒脱",
            "待人温柔体贴",
            "机敏狡黠",
            "颇有城府",
            "善随机应变",
            "重情重义"
          ]
        }
      },
      {
        "id": "liuchao.character.xiao_zi",
        "name": "小紫",
        "description": "身为程宗扬的助手，小紫素来以娇俏灵动的紫衫丽人之姿示人，肤白如乳、玉脸精致皎洁，但那双星眸深处暗藏的算计与城府，却让各房后宫皆被她不动声色地收服；她善使毒与机关虫蚁，总是一脸天真无辜地靠近你，唇角微弯时，银环穿透的胸乳间银铃轻响，温柔如水的目光下却已悄然布下天罗地网。",
