    {
      "op": "set",
      "path": "canon.characters[id=liuchao.character.qi_yuan].description",
      "from": "程氏商会在江州的锦衣掌柜缩在榻边，腊黄的脸埋进账册，弓成虾米的脊背里藏着南荒九死一生的旧伤——他替程宗扬管着的，岂止是账面上的银钱。",
      "to": "白湖商馆的老行商，走过几次南荒；这一程替商队带路，管奴隶。"
    },
    {
      "op": "set",
      "path": "scenario.chapters[id=lcq.chapter.stage_08_jiankang_coup_sudaji].eventIds",
      "from": [
        "lcq.event.s08_04_sudaji_enters",
        "lcq.event.s08_05_breakthrough",
        "lcq.event.s08_06_pursuit_repelled"
      ],
      "to": [
        "lcq.event.s08_04_sudaji_enters",
        "lcq.event.s08_05_breakthrough",
        "lcq.event.s08_06_pursuit_repelled",
        "lcq.event.palm_oath_shanghou"
      ]
    },
    {
      "op": "set",
      "path": "canon.locations[id=liuchao.location.changan].description",
      "from": "唐国都城，六朝最大城市。 六朝蹴鞠圣地，唐室大明宫巍峨，城门巍峨，常有鞠社云集，设皇图天策府邸，街市热闹。（民俗：蹴鞠之风极盛，山岳正赛年年在此举办，六朝三十二支鞠社竞逐，是唐国最热闘的体育盛事。）",
      "to": "唐国都城，六朝最大城市。 六朝蹴鞠圣地，唐室大明宫巍峨，城门巍峨，常有鞠社云集，设皇图天策府邸，街市热闹。（民俗：蹴鞠之风极盛，山岳正赛年年在此举办，六朝三十二支鞠社竞逐，是唐国最热闹的体育盛事。）"
    },
    {
      "op": "set",
      "path": "canon.characters[id=liuchao.character.qin_han].profile.appearance",
      "from": "头戴紫貂玉珰，锦衣华服，身材精悍，长发飞舞，虎目精光内敛，偶尔目露奇光。；白发萧索，夜眼锐利如鹰隼，目光阴冷。身形稳如渊岳，流露逼人气势。半显阳刚半显阴柔。",
      "to": "头戴紫貂玉珰，锦衣华服，身材精悍，长发飞舞，虎目精光内敛，偶尔目露奇光。；夜眼锐利如鹰隼，目光阴冷。身形稳如渊岳，流露逼人气势。半显阳刚半显阴柔。"
    }
  ]
