{
  "version": 1,
  "tuning": {
    "file": "./tuning.json",
    "timeoutMs": 3000
  },
  "diagnostics": {
    "enabled": true,
    "minLevel": "info",
    "consoleLevel": "warn",
    "persistLevel": "info",
    "ringMax": 500,
    "maxBytes": 524288,
    "detailChars": 400,
    "stackChars": 1200,
    "maxDepth": 4,
    "maxKeys": 20,
    "flushMs": 500,
    "repeatMs": 5000,
    "repeatKeys": 200,
    "localFallbackMax": 50,
    "redactKeys": [
      "apikey",
      "token",
      "accesstoken",
      "authorization",
      "password",
      "secret",
      "cookie",
      "bearer"
    ],
    "redactPatterns": [
      "sk-[A-Za-z0-9_-]{8,}",
      "Bearer\\s+[A-Za-z0-9._~+/=-]{8,}",
      "AIza[0-9A-Za-z_-]{20,}",
      "[?&](?:key|api_key|apikey|token|access_token)=[^&\\s]+"
    ],
    "textKeys": [
      "text",
      "input",
      "playertext",
      "usertext",
      "userinput",
      "prompt",
      "content",
      "evidence",
      "narrative",
      "reply",
      "response"
    ],
    "textChars": 0,
    "toast": {
      "enabled": true,
      "minLevel": "error",
      "dedupeMs": 30000
    },
    "panel": {
      "recent": 30
    },
    "tuning404Level": "info",
    "debug": {
      "note": "调试日志大类开关（debugLog）。只控制控制台调试输出；错误码 / 持久日志（logEvent、logError）不读这里，始终开启。增删大类须用户拍板，id 总表见 src/modules/diagnostics/debugCategories.ts 与 docs/DEBUG-LOG.md。",
      "categories": {
        "identity": false,
        "story": false,
        "narrative": false,
        "freeAction": false,
        "combat": false,
        "npc": false,
        "growth": false,
        "world": false,
        "init": false,
        "ai": false,
        "memory": false,
        "save": false,
        "content": false,
        "ui": false,
        "perf": false
      }
    },
    "divergence": {
      "note": "世界线偏离信号的专名计数（scenarioMods/divergenceControl.ts）：候选专名先在最后一个 stripChars 字处截掉前缀（虚词、代词、动作字），剩下不足 minChars 字、或落在 commonPhrases 里的不算专名；登记在实体总表（人物、地点、势力、敌人）里的名字一律算已知。",
      "properNoun": {
        "stripChars": "的了在是着把被向往从到和与及或你我他她它们这那此该其各每几一二两三个座整全满又也都就将正已便才还再去来对给为让令朝上下进出回入离开过前后",
        "minChars": 3,
        "commonPhrases": [
          "老江湖",
          "闯江湖",
          "大宗门",
          "小宗门",
          "名门正派",
          "邪魔外道",
