{
  "version": 1,
  "tuning": {
    "file": "./tuning.json",
    "timeoutMs": 3000
  },
  "diagnostics": {
    "enabled": true,
    "minLevel": "info",
    "consoleLevel": "warn",
    "persistLevel": "info",
    "ringMax": 2000,
    "maxBytes": 2097152,
    "detailChars": 400,
    "stackChars": 1200,
    "maxDepth": 4,
    "maxKeys": 20,
    "flushMs": 500,
    "repeatMs": 5000,
    "repeatKeys": 200,
    "localFallbackMax": 50,
    "redactKeys": [
      "apikey",
      "token",
      "accesstoken",
      "authorization",
      "password",
      "secret",
      "cookie",
      "bearer"
    ],
    "redactPatterns": [
      "sk-[A-Za-z0-9_-]{8,}",
      "Bearer\\s+[A-Za-z0-9._~+/=-]{8,}",
      "AIza[0-9A-Za-z_-]{20,}",
      "[?&](?:key|api_key|apikey|token|access_token)=[^&\\s]+"
    ],
    "textKeys": [
      "text",
      "input",
      "playertext",
      "usertext",
      "userinput",
      "prompt",
      "content",
      "evidence",
      "narrative",
      "reply",
      "response"
    ],
    "textChars": 0,
    "toast": {
      "enabled": true,
      "minLevel": "error",
      "dedupeMs": 30000
    },
    "panel": {
      "recent": 30
    },
    "tuning404Level": "info",
    "debug": {
      "note": "调试日志大类开关（debugLog）。只控制控制台调试输出；错误码 / 持久日志（logEvent、logError）不读这里，始终开启。增删大类须用户拍板，id 总表见 src/modules/diagnostics/debugCategories.ts 与 docs/DEBUG-LOG.md。",
      "categories": {
        "identity": false,
        "story": false,
        "narrative": false,
        "freeAction": false,
        "combat": false,
        "npc": false,
        "growth": false,
        "world": false,
        "init": false,
        "ai": false,
        "memory": false,
        "save": false,
        "content": false,
        "ui": false,
        "perf": false
      }
    },
    "rotation": {
      "note": "持久日志轮转（lcq-log，落盘时检查）：早于 retentionDays 天的记录删掉；条数超过 ringMax 或总大小（JSON 字符数）超过 maxBytes 时从最老的删，一次删到 trimToRatio 倍以下（留出余量，避免每写一条就轮转一次）；每次轮转记一条 LCQ-SYS-002。说明见 docs/NARRATIVE-SOURCE-LOG.md。",
      "retentionDays": 3,
      "trimToRatio": 0.8
    },
    "narrativeSource": {
      "note": "叙事来源日志（diagnostics/narrativeSource.ts）：模型每生成一段玩家可见正文记 LCQ-NAR-001（来源 + 全文）；正文里夹在中文之间的拉丁单词（字母数 ≥ minLetters，前后 contextChars 字内有汉字，不在两张白名单里，不分大小写）记 LCQ-NAR-002，带命中词与前后各 contextChars 字。只记录，不改写正文。nameWhitelist＝人名专名，colloquialWhitelist＝程宗扬现代口语。说明见 docs/NARRATIVE-SOURCE-LOG.md。",
      "minLetters": 3,
      "contextChars": 20,
      "nameWhitelist": [
        "DNA",
        "CEO",
        "VIP",
        "KTV",
        "GPS",
        "USB",
        "MBA",
        "NBA",
        "iPhone"
      ],
      "colloquialWhitelist": [
        "okay",
        "hello",
        "bye",
        "sorry",
        "yes",
        "wow",
        "yeah",
        "oops",
        "cool",
        "baby",
        "honey",
        "party",
        "bingo",
        "show",
        "boss",
        "fans",
        "pass",
        "kiss",
        "sexy",
        "pose",
        "high",
        "low",
        "man",
        "hold",
        "out",
        "god",
        "damn",
        "shit",
        "fuck"
      ]
    },
    "divergence": {
      "note": "世界线偏离信号的专名计数（scenarioMods/divergenceControl.ts）：候选专名先在最后一个 stripChars 字处截掉前缀（虚词、代词、动作字），剩下不足 minChars 字、或落在 commonPhrases 里的不算专名；登记在实体总表（人物、地点、势力、敌人）里的名字一律算已知。",
      "properNoun": {
        "stripChars": "的了在是着把被向往从到和与及或你我他她它们这那此该其各每几一二两三个座整全满又也都就将正已便才还再去来对给为让令朝上下进出回入离开过前后",
        "minChars": 3,
        "commonPhrases": [
          "老江湖",
          "闯江湖",
          "大宗门",
          "小宗门",
          "名门正派",
          "邪魔外道",
          "大本营",
          "满朝",
          "众门派",
          "护山大阵",
          "议事堂",
          "演武堂",
          "练功堂",
          "藏经阁",
          "大殿",
          "正殿",
          "偏殿",
          "后山",
          "深山",
          "荒山",
          "大山",
          "群山",
          "高山",
          "城门",
          "山门",
          "宫门",
          "大门",
          "江湖",
          "门派",
          "宗门",
          "师门",
          "同门",
          "军营",
          "大军",
          "王国",
          "国王",
          "天下"
        ]
      }
    }
  },
  "saves": {
    "rotationKeep": 3,
    "rotationExcludeSlots": [
      "上次对话"
    ]
  },
  "aiRetry": {
    "maxRetries": 1,
    "retryStatuses": [
      408,
      409,
      425,
      429,
      500,
      502,
      503,
      504
    ],
    "baseDelayMs": 1000,
    "maxDelayMs": 8000,
    "factor": 2,
    "jitter": 0.25,
    "retryOnTimeout": false,
    "retryAfterMaxMs": 20000
  },
  "feedback": {
    "redactSaveNarrative": true,
    "narrativePaths": [
      [
        "系统",
        "历史",
        "叙事"
      ],
      [
        "社交",
        "记忆"
      ]
    ],
    "narrativeKeepKeys": [
      "type",
      "time"
    ]
  },
  "e2eSmoke": {
    "scriptTimeoutMs": 300000
  },
  "perf": {
    "sampleWindow": 50,
    "minSamplesForPercentile": 5,
    "turnWarnMs": 90000,
    "modelWarnMs": 60000
  },
  "ui": {
    "note": "界面显示开关（只管玩家看不看得到，不删代码、数据、文案）。rightSidebar.showSecondaryLines：右栏「可投的门路」整块（secondaryLines 二级线入口＋questLineView 支线）是否显示；用户 2026-10-27 08:53 定先隐藏不删，默认 false。rightSidebar.showLineCompass：右栏「当前线」卡（线名＋下一步一句，别处已知的线默认收起只列线名；右栏线入口复用分析 2026-10-27 §5，用户 2026-10-27 09:26 定）是否显示；开时放在原主线指南针那一行的位置、取代它，与「可投的门路」两块不并存（两个都开时只显示当前线卡）；用户 2026-10-27 08:57 定改完后不再隐藏，默认 true（showSecondaryLines 仍为 false）。worldSelection.showGenericWorlds：创建角色第 1 步「普通世界」入口（自定义世界、AI推演、本地世界列表、世界规模配置、保存预设与加载预设）是否显示；用户 2026-10-28 定先隐藏不删，默认 false；关时剧本模组与修仙难度照常，旧普通世界存档照常可读。modeSelection.showGenericStart：首页「初入仙途」（普通创角入口）是否显示；用户 2026-10-29 定先隐藏不删，默认 false；关时首页主按钮为「入六朝」（直入 lcq.stage_01 第 7 步预览），续前世因缘与剧本模组照常。",
    "rightSidebar": {
      "showSecondaryLines": false,
      "showLineCompass": true
    },
    "worldSelection": {
      "showGenericWorlds": false
    },
    "modeSelection": {
      "showGenericStart": false
    },
    "legacyPilotActionOptions": {
      "min": 2,
      "max": 4
    }
  }
}
