{
  "version": 1,
  "tuning": {
    "file": "./tuning.json",
    "timeoutMs": 3000
  },
  "diagnostics": {
    "enabled": true,
    "minLevel": "info",
    "consoleLevel": "warn",
    "persistLevel": "info",
    "ringMax": 500,
    "maxBytes": 524288,
    "detailChars": 400,
    "stackChars": 1200,
    "maxDepth": 4,
    "maxKeys": 20,
    "flushMs": 500,
    "repeatMs": 5000,
    "repeatKeys": 200,
    "localFallbackMax": 50,
    "redactKeys": [
      "apikey",
      "token",
      "accesstoken",
      "authorization",
      "password",
      "secret",
      "cookie",
      "bearer"
    ],
    "redactPatterns": [
      "sk-[A-Za-z0-9_-]{8,}",
      "Bearer\\s+[A-Za-z0-9._~+/=-]{8,}",
      "AIza[0-9A-Za-z_-]{20,}",
      "[?&](?:key|api_key|apikey|token|access_token)=[^&\\s]+"
    ],
    "textKeys": [
      "text",
      "input",
      "playertext",
      "usertext",
      "userinput",
      "prompt",
      "content",
      "evidence",
      "narrative",
      "reply",
      "response"
    ],
    "textChars": 0,
    "toast": {
      "enabled": true,
      "minLevel": "error",
      "dedupeMs": 30000
    },
    "panel": {
      "recent": 30
    },
    "tuning404Level": "info"
  },
  "saves": {
    "rotationKeep": 3,
    "rotationExcludeSlots": [
      "上次对话"
    ]
  },
  "aiRetry": {
    "maxRetries": 1,
    "retryStatuses": [
      408,
      409,
      425,
      429,
      500,
      502,
      503,
      504
    ],
    "baseDelayMs": 1000,
    "maxDelayMs": 8000,
    "factor": 2,
    "jitter": 0.25,
    "retryOnTimeout": false,
    "retryAfterMaxMs": 20000
  },
  "feedback": {
    "redactSaveNarrative": true,
    "narrativePaths": [
      [
        "系统",
        "历史",
        "叙事"
      ],
      [
        "社交",
        "记忆"
      ]
    ],
    "narrativeKeepKeys": [
      "type",
      "time"
    ]
  },
  "e2eSmoke": {
    "scriptTimeoutMs": 300000
  },
  "perf": {
    "sampleWindow": 50,
    "minSamplesForPercentile": 5,
    "turnWarnMs": 90000,
    "modelWarnMs": 60000
  }
}
