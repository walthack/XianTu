      "id": "lcq.ending.death.wangzhe_blast",
      "aliases": [],
      "definition": {
        "id": "lcq.ending.death.wangzhe_blast",
        "title": "十里焦土",
        "facts": [
          "王哲以九阳神功合一，化为太阳之火与敌军同归于尽",
          "草原化为十里焦土",
          "程宗扬没有离开战场，被焰浪吞没",
          "月霜没有被带走"
        ],
        "name": "十里焦土"
      },
      "stageVariants": {},
      "authoritySource": "mod-kit/entity-catalog/endings.json",
