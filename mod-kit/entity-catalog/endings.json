        "src/modules/scenarioMods/builtins/data/lcq.stage_02.json"
      ]
    },
    {
      "id": "lcq.ending.death.paolao",
      "aliases": [],
      "definition": {
        "id": "lcq.ending.death.paolao",
        "title": "炮烙",
        "facts": [
          "程宗扬当面拒绝三个月南荒之约",
          "苏妲己依约执行炮烙",
          "霓龙丝无人去采，南荒之行未曾成行"
        ],
        "name": "炮烙"
      },
      "stageVariants": {},
      "authoritySource": "mod-kit/entity-catalog/endings.json",
